# Copy this file to .env and fill in your key.
#   cp .env.example .env

# Required. Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional. Defaults shown. ANTHROPIC_THINKING is "off" or an effort level.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_THINKING=off

# To run on OpenAI instead, set the provider and an OpenAI key.
# CABIN_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=none

# Uncomment to print AI debug output to the terminal.
# CABIN_DEBUG=1
