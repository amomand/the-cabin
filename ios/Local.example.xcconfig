// Copy this file to Local.xcconfig. That file is ignored by git.
// Xcode expands each value into the app's launch environment once; the app
// moves it into this install's device-only Keychain for later Home-Screen
// launches. Nothing here is copied into Info.plist, bundle resources, Swift
// session persistence, or Python checkpoints.
// The engine's default provider is Anthropic; set the OpenAI key only when
// running with CABIN_MODEL_PROVIDER=openai.
CABIN_LOCAL_ANTHROPIC_API_KEY = your-private-key
CABIN_LOCAL_OPENAI_API_KEY =
